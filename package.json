{
  "name": "api-handshake-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A working Express + Vite demo that uses the published api-handshake npm package",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "start": "node server/index.js",
    "build": "vite build"
  },
  "dependencies": {
    "api-handshake": "^0.1.0",
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^8.3.8"
  }
}
